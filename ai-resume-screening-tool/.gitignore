# ----- Byte-compiled / cache files -----
__pycache__/
*.py[cod]
*$py.class

# ----- Virtual environments -----
venv/
.venv/
env/
ENV/

# ----- Distribution / packaging -----
build/
dist/
*.egg-info/

# ----- Environment variables / secrets -----
.env
.env.*

# ----- IDE / editor files -----
.vscode/
.idea/
*.swp

# ----- OS files -----
.DS_Store
Thumbs.db

# ----- Streamlit -----
.streamlit/secrets.toml

# ----- Project-specific data (uploaded resumes, generated results) -----
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ----- Trained/serialized models -----
models/*
!models/.gitkeep

# ----- Generated outputs (reports, ranked candidate lists, exports) -----
outputs/*
!outputs/.gitkeep

# ----- Logs -----
*.log

# ----- Jupyter -----
.ipynb_checkpoints/
